          }
        }
      },
      "transform": [
        {
          "filter": "datum.short == 'QVMAG'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "dy": -4,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#3b382f"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
