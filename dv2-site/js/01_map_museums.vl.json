            "pct_away": "number",
            "undated_records": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof(['AM','MV','QM'], datum.short) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 36,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#3b382f"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "city"
        }
      }
    },
    {
