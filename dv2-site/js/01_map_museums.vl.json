        "url": "data/museums.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "founded": "number",
            "collection_size": "number",
            "ala_records": "number",
            "pct_digitised": "number",
            "type_specimens": "number",
            "holotypes": "number",
